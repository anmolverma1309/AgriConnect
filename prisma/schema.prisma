generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String    @unique
  password      String
  location      String?
  landArea      Float?
  crops         String?
  aadhaar       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  listings      Listing[]
  orders        Order[]
  tasks         Task[]
  cropsLog      Crop[]
  documents     Document[]
  loans         Loan[]
  bookings      Booking[]
}

model Listing {
  id            String    @id @default(cuid())
  userId        String
  cropName      String
  quantity      Float
  unit          String    @default("quintal")
  price         Float
  description   String?
  location      String
  market        String
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id])
}

model Product {
  id            String    @id @default(cuid())
  name          String
  category      String
  price         Float
  stock         Int
  unit          String
  description   String?
  seller        String
  image         String?
  createdAt     DateTime  @default(now())
  
  orderItems    OrderItem[]
}

model Order {
  id            String    @id @default(cuid())
  userId        String
  total         Float
  status        String    @default("pending")
  address       String
  city          String
  pincode       String
  paymentMethod String
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int
  price         Float
  
  order         Order     @relation(fields: [orderId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
}

model Task {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  status        String    @default("pending")
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id])
}

model Crop {
  id            String    @id @default(cuid())
  userId        String
  name          String
  area          Float
  areaUnit      String    @default("acres")
  expectedYield Float?
  actualYield   Float?
  plantingDate  DateTime?
  harvestDate   DateTime?
  status        String    @default("planned")
  
  user          User      @relation(fields: [userId], references: [id])
}

model Document {
  id            String    @id @default(cuid())
  userId        String
  name          String
  type          String
  url           String
  summary       String?
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id])
}

model Loan {
  id            String    @id @default(cuid())
  userId        String
  type          String
  amount        Float
  purpose       String
  status        String    @default("pending")
  bank          String?
  emi           Float?
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id])
}

model Booking {
  id            String    @id @default(cuid())
  userId        String
  type          String
  item          String
  date          DateTime
  workers       Int?
  days          Int?
  location      String
  price         Float
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id])
}

model Labour {
  id            String    @id @default(cuid())
  name          String
  phone         String
  skills        String
  location      String
  pricePerDay   Float
  available     Boolean   @default(true)
  rating        Float     @default(0)
  createdAt     DateTime  @default(now())
}

model Tool {
  id            String    @id @default(cuid())
  name          String
  owner         String
  location      String
  pricePerDay   Float
  available     Boolean   @default(true)
  description   String?
  image         String?
  createdAt     DateTime  @default(now())
}

model MarketPrice {
  id            String    @id @default(cuid())
  crop          String
  market        String
  price         Float
  unit          String    @default("quintal")
  change        Float
  updatedAt     DateTime  @updatedAt
  
  @@unique([crop, market])
}

model Video {
  id            String    @id @default(cuid())
  title         String
  author        String
  category      String
  thumbnail     String
  url           String
  views         Int       @default(0)
  duration      String
  createdAt     DateTime  @default(now())
}
